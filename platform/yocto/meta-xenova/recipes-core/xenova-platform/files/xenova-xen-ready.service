[Unit]
Description=Verify Xen dom0 control interface and xl toolstack
Requires=xenstored.service xenconsoled.service xen-init-dom0.service xenova-first-boot.service
After=xenstored.service xenconsoled.service xen-init-dom0.service xenova-first-boot.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/xenova-vm boot-domains
ExecStart=/usr/sbin/xenova-vm check-xen
RemainAfterExit=yes
TimeoutStartSec=75s
