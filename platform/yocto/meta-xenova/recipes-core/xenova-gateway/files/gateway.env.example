# Install a filled copy as root:root 0600 at /etc/xenova/gateway.env.
# Follow the Gateway README for the Recovery Worker and USB activation.
XENOVA_GATEWAY_PROFILE=warm
XENOVA_GATEWAY_VM_A=
XENOVA_GATEWAY_VM_B=
XENOVA_GATEWAY_BROKER_HOST=
XENOVA_GATEWAY_BROKER_USERNAME=
XENOVA_GATEWAY_BROKER_PASSWORD=
XENOVA_GATEWAY_SINK=serial
# Fill with the registered /dev/serial/by-id/ path.
XENOVA_GATEWAY_SERIAL_PORT=
XENOVA_GATEWAY_SERIAL_BAUD=460800
XENOVA_GATEWAY_SERIAL_PROFILE=feedback-3
XENOVA_GATEWAY_ODOMETRY_CONFIG=/etc/xenova/gateway-odometry.json
XENOVA_GATEWAY_FEEDBACK3_PROFILE=/etc/xenova/gateway-feedback3.json
# Supply the approved timeout in ms from the ESP32 installation.
XENOVA_GATEWAY_FEEDBACK_TIMEOUT_MS=
XENOVA_GATEWAY_IPC_SOCKET=/run/xenova-gateway/control.sock
XENOVA_GATEWAY_VEHICLE_LIMITS=/etc/xenova/vehicle-limits.json
XENOVA_GATEWAY_AUTHORITY_DIR=/srv/xenova/drive-control
XENOVA_GATEWAY_BINDING_FILE=/run/xenova/drive-bindings.json
# Optional operating map and clock policy matched to the approved Jetson profile.
# XENOVA_GATEWAY_MAPPER_UPLINK_PROFILE=/etc/xenova/gateway-mapper-uplink.json
# Optional approved root:root 0600 JSON {retry_ms,retention_ms}; no operating values supplied.
# Selecting history policy requires time-bearing keys for NEW provider requests.
# XENOVA_GATEWAY_HISTORY_POLICY=/etc/xenova/gateway-history.json
